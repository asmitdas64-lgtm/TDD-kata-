# Node.js Server Environment Configuration
NODE_ENV=development
PORT=5000

# MySQL Connection String (Prisma format)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/cardealership"

# JSON Web Token Secret & Expiration
# Must be at least 32 characters in length
JWT_SECRET="replace_with_a_secure_random_at_least_32_char_secret_key"
JWT_EXPIRES_IN="24h"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
